{
  "organization": "Ridgeview Consulting Limited",
  "default-configuration": "Release",
  "configurations": [
    { "name": "Debug", "file": { "anchor": "Config", "relative-path": "Debug.xcconfig" } },
    { "name": "Release", "file": { "anchor": "Config", "relative-path": "Release.xcconfig" } },
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "es",
      "es-MX",
      "fr",
      "fr-CA",
    ],
  },
  "files": [
    { "path": "README.md" },
    {
      "kind": "group",
      "name": "Tooling",
      "children": [
        { "kind": "folder", "path": ".github" },
        {
          "kind": "group",
          "path": "fastlane",
          "children": [
            { "kind": "folder", "path": "metadata" },
            { "path": "Appfile" },
            { "path": "Deliverfile" },
            { "path": "Fastfile" },
            { "path": "Pluginfile" },
            { "path": "Snapfile" },
          ],
        },
        { "kind": "folder", "path": "Scripts" },
        { "path": ".gitignore" },
        { "path": ".ruby-version" },
        { "path": ".swift-format" },
        { "path": ".xcode-version" },
        { "path": "AGENTS.md" },
        { "path": "Gemfile" },
      ],
    }, {
      "kind": "group",
      "path": "Packages",
      "children": [
        { "path": "DataStores" },
        { "path": "Models" },
        { "path": "PresentationViews" },
        { "path": "Shared" },
      ],
    },
    { "kind": "folder", "path": "Config" },
    {
      "kind": "folder",
      "path": "EarningsMeter",
      "target-membership": [
        "EarningsMeter",
      ],
      "membership-exceptions": [
        {
          "target": "EarningsMeter",
          "exclusions": [
            "Info.plist",
            "PrivacyInfo.xcprivacy",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "EarningsMeterTests" },
    {
      "kind": "folder",
      "path": "EarningsMeterUITests",
      "target-membership": [
        "EarningsMeterUITests",
      ],
      "membership-exceptions": [
        {
          "target": "EarningsMeterUITests",
          "exclusions": [
            "Info.plist",
            "TestPlans/Screenshots.xctestplan",
            "TestPlans/UIFunctional.xctestplan",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "EarningsMeterWidget",
      "target-membership": [
        "EarningsMeterWidgetExtension",
      ],
      "membership-exceptions": [
        {
          "target": "EarningsMeterWidgetExtension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Earnings Meter.app", "id": "312821C423D0B95E00975F66", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/EarningsMeterTests.xctest", "id": "3190F6DA24CF0B6A004303F0", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/EarningsMeterUITests.xctest", "id": "314A715825BAF8F90062D050", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/EarningsMeterWidgetExtension.appex", "id": "31658F8F28D37759005466C2", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "EarningsMeter/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "EarningsMeter",
      "id": "312821C323D0B95E00975F66",
      "product": "Products/Earnings Meter.app",
      "product-type": "application",
      "dependencies": [
        "EarningsMeterWidgetExtension",
      ],
      "build-phases": [
        {
          "kind": "script",
          "name": "Swift format",
          "log-environment-variables": true,
          "run-on-every-build": true,
          "shell": "/bin/sh",
          "script": "\"$SRCROOT/Scripts/swift-format-lint.sh\"\n",
        },
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "package-product-members": [
        {
          "product-name": "DataStores",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "Models",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "PresentationViews",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_ENTITLEMENTS": "Config/Entitlements/EarningsMeter.entitlements",
        "CODE_SIGN_IDENTITY[config=Debug]": "Apple Development",
        "DEVELOPMENT_ASSET_PATHS": "\"EarningsMeter/Preview Content\"",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
        "INFOPLIST_FILE": "EarningsMeter/Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "$(MAIN_TARGET_BUNDLE_ID)",
        "PRODUCT_NAME": "Earnings Meter",
        "PROVISIONING_PROFILE_SPECIFIER[config=Release]": "match AppStore $(PRODUCT_BUNDLE_IDENTIFIER)",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "VERSIONING_SYSTEM": "apple-generic",
      },
    }, {
      "name": "EarningsMeterTests",
      "id": "3190F6D924CF0B6A004303F0",
      "product": "Products/EarningsMeterTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "EarningsMeter",
      "dependencies": [
        "EarningsMeter",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGN_STYLE": "Automatic",
        "INFOPLIST_FILE": "EarningsMeterTests/Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@loader_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.ridgeviewapps.Contract-MeterTests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/Earnings Meter.app/Earnings Meter",
      },
    }, {
      "name": "EarningsMeterUITests",
      "id": "314A715725BAF8F80062D050",
      "product": "Products/EarningsMeterUITests.xctest",
      "product-type": "bundle.ui-testing",
      "test-host-target": "EarningsMeter",
      "dependencies": [
        "EarningsMeter",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "Shared",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "CODE_SIGN_STYLE": "Automatic",
        "INFOPLIST_FILE": "EarningsMeterUITests/Info.plist",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@loader_path/Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "com.ridgeviewapps.EarningsMeterUITests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "TEST_TARGET_NAME": "EarningsMeter",
      },
    }, {
      "name": "EarningsMeterWidgetExtension",
      "id": "31658F8E28D37759005466C2",
      "product": "Products/EarningsMeterWidgetExtension.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "DataStores",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "Models",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "PresentationViews",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "ASSETCATALOG_COMPILER_WIDGET_BACKGROUND_COLOR_NAME": "WidgetBackground",
        "CLANG_CXX_LANGUAGE_STANDARD": "gnu++17",
        "CODE_SIGN_ENTITLEMENTS": "Config/Entitlements/EarningsMeterWidgetExtension.entitlements",
        "CURRENT_PROJECT_VERSION": "1",
        "ENABLE_USER_SCRIPT_SANDBOXING": "NO",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "EarningsMeterWidget/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "EarningsMeterWidget",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "Copyright © 2022 Shilan Patel. All rights reserved.",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "$(MAIN_TARGET_BUNDLE_ID).widgetExtension",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "PROVISIONING_PROFILE_SPECIFIER[config=Release]": "match AppStore $(PRODUCT_BUNDLE_IDENTIFIER)",
        "SKIP_INSTALL": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
        "VERSIONING_SYSTEM": "apple-generic",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS": "YES",
    "CLANG_ANALYZER_LOCALIZABILITY_NONLOCALIZED": "YES",
    "CLANG_ANALYZER_NONNULL": "YES",
    "CLANG_ANALYZER_NUMBER_OBJECT_CONVERSION": "YES_AGGRESSIVE",
    "CLANG_CXX_LANGUAGE_STANDARD": "gnu++14",
    "CLANG_CXX_LIBRARY": "libc++",
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_ENABLE_OBJC_WEAK": "YES",
    "CLANG_WARN_BLOCK_CAPTURE_AUTORELEASING": "YES",
    "CLANG_WARN_BOOL_CONVERSION": "YES",
    "CLANG_WARN_COMMA": "YES",
    "CLANG_WARN_CONSTANT_CONVERSION": "YES",
    "CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS": "YES",
    "CLANG_WARN_DIRECT_OBJC_ISA_USAGE": "YES_ERROR",
    "CLANG_WARN_DOCUMENTATION_COMMENTS": "YES",
    "CLANG_WARN_EMPTY_BODY": "YES",
    "CLANG_WARN_ENUM_CONVERSION": "YES",
    "CLANG_WARN_INFINITE_RECURSION": "YES",
    "CLANG_WARN_INT_CONVERSION": "YES",
    "CLANG_WARN_NON_LITERAL_NULL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
    "CLANG_WARN_OBJC_LITERAL_CONVERSION": "YES",
    "CLANG_WARN_OBJC_ROOT_CLASS": "YES_ERROR",
    "CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER": "YES",
    "CLANG_WARN_RANGE_LOOP_ANALYSIS": "YES",
    "CLANG_WARN_STRICT_PROTOTYPES": "YES",
    "CLANG_WARN_SUSPICIOUS_MOVE": "YES",
    "CLANG_WARN_UNGUARDED_AVAILABILITY": "YES_AGGRESSIVE",
    "CLANG_WARN_UNREACHABLE_CODE": "YES",
    "CLANG_WARN__DUPLICATE_METHOD_MATCH": "YES",
    "COPY_PHASE_STRIP": "NO",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "DEVELOPMENT_TEAM": "3H5L23529U",
    "ENABLE_NS_ASSERTIONS[config=Release]": "NO",
    "ENABLE_STRICT_OBJC_MSGSEND": "YES",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "GCC_C_LANGUAGE_STANDARD": "gnu11",
    "GCC_DYNAMIC_NO_PIC[config=Debug]": "NO",
    "GCC_NO_COMMON_BLOCKS": "YES",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_PREPROCESSOR_DEFINITIONS[config=Debug]": [
      "DEBUG=1",
      "$(inherited)",
    ],
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_ABOUT_RETURN_TYPE": "YES_ERROR",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNINITIALIZED_AUTOS": "YES_AGGRESSIVE",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "IPHONEOS_DEPLOYMENT_TARGET": "18.0",
    "MARKETING_VERSION": "$(APP_VERSION_NUMBER)",
    "MTL_ENABLE_DEBUG_INFO[config=Debug]": "INCLUDE_SOURCE",
    "MTL_ENABLE_DEBUG_INFO[config=Release]": "NO",
    "MTL_FAST_MATH": "YES",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SDKROOT": "iphoneos",
    "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_OPTIMIZATION_LEVEL[config=Release]": "-O",
    "VALIDATE_PRODUCT[config=Release]": "YES",
  },
  "last-upgrade": "16.0",
  "last-swift-update": "13.4",
}
